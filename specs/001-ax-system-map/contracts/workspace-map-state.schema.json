{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/workspace-map-state.schema.json",
  "title": "Workspace Map State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "generatedAt",
    "rootLabel",
    "staleAfterMs",
    "durationMs",
    "nodes",
    "edges",
    "views",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["live", "baseline"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "rootLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
    "staleAfterMs": { "type": "integer", "minimum": 1000, "maximum": 30000 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/nodeState" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/view" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+"
    },
    "nodeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "reason",
        "paths",
        "artifactCount",
        "latestModifiedAt",
        "evidencePaths"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "status": {
          "enum": ["conceptual", "expected", "present", "verified", "needs-review"]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeRelativePath" }
        },
        "artifactCount": { "type": "integer", "minimum": 0 },
        "latestModifiedAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "evidencePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeRelativePath" }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "label", "style"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "from": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "to": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "style": { "enum": ["normal", "emphasis", "feedback", "future"] }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "focusNodeIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "focusNodeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conceptual", "expected", "present", "verified", "needsReview", "total"],
      "properties": {
        "conceptual": { "type": "integer", "minimum": 0 },
        "expected": { "type": "integer", "minimum": 0 },
        "present": { "type": "integer", "minimum": 0 },
        "verified": { "type": "integer", "minimum": 0 },
        "needsReview": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
