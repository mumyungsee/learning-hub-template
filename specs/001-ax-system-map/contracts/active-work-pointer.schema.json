{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/active-work-pointer.schema.json",
  "title": "Active Workspace Map Work Pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "artifacts", "extensions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "artifacts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "path"],
        "properties": {
          "nodeId": { "enum": ["spec", "verify", "output", "handoff"] },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)(?!.*[*?]).+"
          },
          "evidenceKind": { "const": "checked-checklist" }
        }
      }
    },
    "extensions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "type", "paths"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "type": { "enum": ["skill", "script", "mcp", "api", "database", "pkm"] },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)(?!.*[*?]).+"
            }
          }
        }
      }
    }
  }
}
