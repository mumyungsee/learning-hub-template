---
import Base from '../../layouts/Base.astro';
import {
  createBaselineSnapshot,
  mapManifest,
  statusMeta,
} from '../../../scripts/workspace-map/manifest.mjs';

const baselineSnapshot = createBaselineSnapshot('learning-hub-template');
const orderedNodes = [...mapManifest.nodes].sort((a, b) => a.order - b.order);
const pageData = JSON.stringify({
  manifest: mapManifest,
  snapshot: baselineSnapshot,
  statusMeta,
}).replaceAll('<', '\\u003c');
---

<Base title="나의 업무 위임 시스템" full>
  <div class="map-page">
    <header class="map-header">
      <p class="eyebrow">AX 실습 구조 지도</p>
      <h1>{mapManifest.title}</h1>
      <p>{mapManifest.description}</p>
    </header>

    <section class="live-status" data-live-state="connecting" aria-live="polite">
      <div>
        <strong id="status-message">로컬 상태를 연결하고 있어요.</strong>
        <span id="workspace-label">기본 구조</span>
      </div>
      <dl>
        <div><dt>마지막 확인</dt><dd id="last-confirmed">아직 없음</dd></div>
        <div><dt>확인 시간</dt><dd id="scan-duration">—</dd></div>
      </dl>
    </section>

    <nav class="view-tabs" aria-label="구조 지도 보기 선택">
      {mapManifest.views.map((view, index) => (
        <button
          type="button"
          data-view-id={view.id}
          data-focus={view.focusNodeIds.join(',')}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {view.label}
        </button>
      ))}
    </nav>
    <p id="view-description" class="view-description">{mapManifest.views[0].description}</p>

    <section class="legend" aria-label="상태 판독 기준">
      <h2>상태 판독 기준</h2>
      <div class="legend-items">
        {Object.entries(statusMeta).map(([status, meta]) => (
          <span data-status={status}><b aria-hidden="true">{meta.symbol}</b>{meta.label}</span>
        ))}
      </div>
    </section>

    <div class="map-layout">
      <section class="map-flow" aria-label="업무 위임 구조">
        {orderedNodes.map((node, index) => {
          const initialState = baselineSnapshot.nodes.find((item) => item.id === node.id);
          const outgoing = mapManifest.edges.filter((edge) => edge.from === node.id);
          return (
            <>
              <article
                class="map-node"
                data-node-id={node.id}
                data-status={initialState?.status ?? 'expected'}
              >
                <button type="button" class="node-toggle" aria-controls="node-detail">
                  <span class="node-heading">
                    <span class="node-order">{String(index + 1).padStart(2, '0')}</span>
                    <span>
                      <strong>{node.label}</strong>
                      <small>{node.role}</small>
                    </span>
                  </span>
                  <span class="node-state">
                    <span class="status-badge" data-node-status>
                      {statusMeta[initialState?.status ?? 'expected'].symbol}
                      {statusMeta[initialState?.status ?? 'expected'].label}
                    </span>
                    <span data-node-count>0개</span>
                  </span>
                </button>
                <p class="node-reason" data-node-reason>{initialState?.reason}</p>
                {outgoing.length > 0 && (
                  <ul class="node-links" aria-label={`${node.label}에서 이어지는 연결`}>
                    {outgoing.map((edge) => {
                      const target = mapManifest.nodes.find((item) => item.id === edge.to);
                      return <li data-edge-style={edge.style}>→ {edge.label} · {target?.label}</li>;
                    })}
                  </ul>
                )}
              </article>
              {index < orderedNodes.length - 1 && <div class="flow-arrow" aria-hidden="true">↓</div>}
            </>
          );
        })}
      </section>

      <aside id="node-detail" class="node-detail" aria-live="polite">
        <p class="detail-kicker">선택한 구성요소</p>
        <h2 id="detail-title">지도의 박스를 눌러봐</h2>
        <p id="detail-role">왜 필요한지, 현재 어떤 파일이 연결됐는지 여기서 확인할 수 있어.</p>
        <dl>
          <div><dt>현재 상태</dt><dd id="detail-status">—</dd></div>
          <div><dt>판정 이유</dt><dd id="detail-reason">—</dd></div>
        </dl>
        <div class="detail-paths">
          <h3>연결된 상대경로</h3>
          <ul id="detail-path-list"><li>아직 선택하지 않았어요.</li></ul>
        </div>
        <div class="detail-evidence">
          <h3>검증 근거</h3>
          <ul id="detail-evidence-list"><li>확인된 근거가 없어요.</li></ul>
        </div>
        <div class="detail-connections">
          <h3>앞에서 들어오는 연결</h3>
          <ul id="detail-incoming-list"><li>앞에서 들어오는 연결이 없어요.</li></ul>
          <h3>다음으로 이어지는 연결</h3>
          <ul id="detail-outgoing-list"><li>다음으로 이어지는 연결이 없어요.</li></ul>
        </div>
      </aside>
    </div>

    <p class="privacy-note">
      이 지도는 현재 프로젝트 안의 정해진 위치만 읽고, 파일 내용·컴퓨터 전체 경로·환경정보는 화면으로 보내지 않아요.
    </p>
  </div>

  <script id="workspace-map-data" type="application/json" set:html={pageData}></script>
</Base>

<script>
  const POLL_INTERVAL_MS = 2_000;
  const CHANGE_HIGHLIGHT_MS = 10_000;
  const ENDPOINT = '/__workspace-map/state.json';
  const SNAPSHOT_STORAGE_KEY = 'workspace-map:last-live-snapshot';
  const source = document.querySelector('#workspace-map-data');
  const pageData = JSON.parse(source?.textContent ?? '{}');
  const manifest = pageData.manifest;
  const statusMeta = pageData.statusMeta;
  let currentSnapshot = pageData.snapshot;
  try {
    const stored = JSON.parse(sessionStorage.getItem(SNAPSHOT_STORAGE_KEY) ?? 'null');
    if (stored?.schemaVersion === 1 && stored?.mode === 'live' && Array.isArray(stored.nodes)) {
      currentSnapshot = stored;
    }
  } catch {
    sessionStorage.removeItem(SNAPSHOT_STORAGE_KEY);
  }
  let lastSuccessful = null;
  let inFlight = false;
  let selectedNodeId = null;
  const highlightTimers = new Map();

  const definitions = new Map(manifest.nodes.map((node) => [node.id, node]));
  const cards = new Map(
    [...document.querySelectorAll('[data-node-id]')].map((element) => [element.dataset.nodeId, element]),
  );
  const statusBox = document.querySelector('.live-status');
  const statusMessage = document.querySelector('#status-message');
  const workspaceLabel = document.querySelector('#workspace-label');
  const lastConfirmed = document.querySelector('#last-confirmed');
  const scanDuration = document.querySelector('#scan-duration');

  function stateFingerprint(state) {
    return JSON.stringify([
      state.status,
      state.paths,
      state.evidencePaths,
      state.artifactCount,
      state.latestModifiedAt,
    ]);
  }

  function changedIds(before, after) {
    if (!before || before.mode !== 'live') return new Set();
    const oldStates = new Map(before.nodes.map((state) => [state.id, state]));
    return new Set(after.nodes
      .filter((state) => stateFingerprint(oldStates.get(state.id) ?? {}) !== stateFingerprint(state))
      .map((state) => state.id));
  }

  function renderList(list, values, emptyText) {
    list.replaceChildren(...(values.length > 0 ? values : [emptyText]).map((value) => {
      const item = document.createElement('li');
      item.textContent = value;
      return item;
    }));
  }

  function renderDetail(nodeId) {
    const definition = definitions.get(nodeId);
    const state = currentSnapshot.nodes.find((item) => item.id === nodeId);
    if (!definition || !state) return;
    selectedNodeId = nodeId;
    document.querySelector('#detail-title').textContent = definition.label;
    document.querySelector('#detail-role').textContent = definition.role;
    document.querySelector('#detail-status').textContent = `${statusMeta[state.status].symbol} ${statusMeta[state.status].label}`;
    document.querySelector('#detail-reason').textContent = state.reason;
    renderList(document.querySelector('#detail-path-list'), state.paths, '아직 연결된 파일이 없어요.');
    renderList(document.querySelector('#detail-evidence-list'), state.evidencePaths, '확인된 검증 근거가 없어요.');
    const incoming = manifest.edges
      .filter((edge) => edge.to === nodeId)
      .map((edge) => `${definitions.get(edge.from)?.label ?? edge.from} → ${edge.label}`);
    const outgoing = manifest.edges
      .filter((edge) => edge.from === nodeId)
      .map((edge) => `${edge.label} → ${definitions.get(edge.to)?.label ?? edge.to}`);
    renderList(document.querySelector('#detail-incoming-list'), incoming, '앞에서 들어오는 연결이 없어요.');
    renderList(document.querySelector('#detail-outgoing-list'), outgoing, '다음으로 이어지는 연결이 없어요.');
    for (const [id, card] of cards) card.classList.toggle('is-selected', id === nodeId);
  }

  function renderSnapshot(snapshot) {
    const before = currentSnapshot;
    const changed = changedIds(before, snapshot);
    currentSnapshot = snapshot;

    for (const state of snapshot.nodes) {
      const card = cards.get(state.id);
      if (!card) continue;
      card.dataset.status = state.status;
      if (changed.has(state.id)) {
        card.classList.add('is-changed');
        window.clearTimeout(highlightTimers.get(state.id));
        const timer = window.setTimeout(() => {
          card.classList.remove('is-changed');
          highlightTimers.delete(state.id);
        }, CHANGE_HIGHLIGHT_MS);
        highlightTimers.set(state.id, timer);
      }
      const badge = card.querySelector('[data-node-status]');
      const reason = card.querySelector('[data-node-reason]');
      const count = card.querySelector('[data-node-count]');
      badge.textContent = `${statusMeta[state.status].symbol} ${statusMeta[state.status].label}`;
      reason.textContent = state.reason;
      count.textContent = state.status === 'conceptual' ? '수업에서 선택' : `${state.artifactCount}개`;
    }
    if (selectedNodeId) renderDetail(selectedNodeId);
  }

  function showConnected(snapshot) {
    statusBox.dataset.liveState = 'live';
    statusMessage.textContent = '현재 폴더와 연결됐어요.';
    workspaceLabel.textContent = snapshot.rootLabel;
    lastConfirmed.textContent = new Date(snapshot.generatedAt).toLocaleTimeString('ko-KR');
    scanDuration.textContent = `${snapshot.durationMs}ms`;
  }

  function showStale() {
    statusBox.dataset.liveState = 'stale';
    statusMessage.textContent = lastSuccessful
      ? '연결이 끊겼어요. 개발 서버를 확인하면 자동으로 다시 연결돼요. 마지막 지도를 보여주고 있어요.'
      : '실시간 상태는 npm run dev로 미리 볼 때 확인할 수 있어요.';
    lastConfirmed.textContent = lastSuccessful
      ? new Date(lastSuccessful).toLocaleTimeString('ko-KR')
      : '연결 안 됨';
    scanDuration.textContent = '재연결 대기';
  }

  async function refreshState() {
    if (document.hidden || inFlight) return;
    inFlight = true;
    try {
      const response = await fetch(ENDPOINT, { cache: 'no-store' });
      if (!response.ok) throw new Error('state-unavailable');
      const snapshot = await response.json();
      renderSnapshot(snapshot);
      try {
        sessionStorage.setItem(SNAPSHOT_STORAGE_KEY, JSON.stringify(snapshot));
      } catch {
        // 저장 공간을 쓸 수 없어도 현재 탭의 실시간 지도는 계속 작동한다.
      }
      lastSuccessful = snapshot.generatedAt;
      showConnected(snapshot);
    } catch {
      showStale();
    } finally {
      inFlight = false;
    }
  }

  for (const [nodeId, card] of cards) {
    card.querySelector('.node-toggle')?.addEventListener('click', () => renderDetail(nodeId));
  }

  const viewDescription = document.querySelector('#view-description');
  for (const button of document.querySelectorAll('[data-view-id]')) {
    button.addEventListener('click', () => {
      const focused = new Set((button.dataset.focus ?? '').split(',').filter(Boolean));
      for (const candidate of document.querySelectorAll('[data-view-id]')) {
        candidate.setAttribute('aria-pressed', String(candidate === button));
      }
      for (const [id, card] of cards) card.classList.toggle('is-dimmed', !focused.has(id));
      viewDescription.textContent = manifest.views.find((view) => view.id === button.dataset.viewId)?.description ?? '';
    });
  }

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refreshState();
  });
  window.setInterval(refreshState, POLL_INTERVAL_MS);
  renderSnapshot(currentSnapshot);
  document.querySelector('[data-view-id]')?.click();
  refreshState();
</script>

<style>
  :global(html) { overflow-x: clip; }
  .map-page { width: 100%; max-width: 1120px; margin: 0 auto; }
  .map-header { max-width: 900px; margin-bottom: 1.5rem; }
  .eyebrow { margin: 0 0 0.35rem; color: var(--muted); font-weight: 800; letter-spacing: 0.08em; }
  .map-header h1 { margin: 0; font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.15; }
  .map-header > p:last-child { margin: 0.85rem 0 0; font-size: 1.2rem; color: var(--muted); }

  .live-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .live-status strong { display: block; font-size: 1.15rem; }
  .live-status span { color: var(--muted); }
  .live-status[data-live-state='live'] { border-color: var(--green-fg); background: var(--green-bg); }
  .live-status[data-live-state='stale'] { border-color: var(--amber-fg); background: var(--amber-bg); }
  .live-status dl { display: flex; gap: 1.5rem; margin: 0; }
  .live-status dl div { min-width: 6rem; }
  .live-status dt { color: var(--muted); font-size: 0.82rem; }
  .live-status dd { margin: 0; font-weight: 800; }

  .view-tabs { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.5rem; }
  .view-tabs button {
    border: 2px solid var(--line);
    border-radius: 999px;
    padding: 0.65rem 1rem;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }
  .view-tabs button[aria-pressed='true'] { border-color: var(--accent); background: var(--accent); color: var(--bg); }
  .view-description { margin: 0.75rem 0 0; color: var(--muted); font-size: 1.05rem; }

  .legend { margin: 1.5rem 0; padding: 0.9rem 1rem; border-block: 1px solid var(--line); }
  .legend h2 { margin: 0 0 0.65rem; font-size: 1.1rem; }
  .legend-items { display: flex; flex-wrap: wrap; gap: 0.65rem; }
  .legend-items span { display: inline-flex; gap: 0.35rem; align-items: center; font-size: 1rem; font-weight: 700; }

  .map-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(270px, 0.38fr); gap: 1.5rem; align-items: start; }
  .map-flow { min-width: 0; }
  .map-node {
    width: 100%;
    border: 2px solid var(--line);
    border-left-width: 8px;
    border-radius: var(--radius);
    background: var(--bg);
    overflow: hidden;
    transition: opacity 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .map-node[data-status='expected'] { border-left-color: var(--amber-fg); background: var(--amber-bg); }
  .map-node[data-status='present'] { border-left-color: var(--accent); }
  .map-node[data-status='verified'] { border-left-color: var(--green-fg); background: var(--green-bg); }
  .map-node[data-status='needs-review'] { border-color: var(--amber-fg); background: var(--amber-bg); }
  .map-node[data-status='conceptual'] { border-left-color: var(--muted); }
  .map-node.is-dimmed { opacity: 0.7; }
  .map-node.is-selected { box-shadow: 0 0 0 3px var(--accent); }
  .map-node.is-changed { transform: translateY(-2px); box-shadow: 0 0 0 4px var(--green-fg); }

  .node-toggle {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.3rem 1.4rem 0.9rem;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    font: inherit;
    cursor: pointer;
  }
  .node-toggle:focus-visible { outline: 3px solid var(--accent); outline-offset: -4px; }
  .node-heading { display: flex; gap: 1rem; min-width: 0; }
  .node-order { flex: 0 0 auto; color: var(--muted); font-weight: 900; font-size: 1.05rem; }
  .node-heading strong { display: block; font-size: 1.45rem; line-height: 1.25; }
  .node-heading small { display: block; margin-top: 0.45rem; color: var(--muted); font-size: 1.05rem; line-height: 1.55; }
  .node-state { flex: 0 0 auto; display: grid; justify-items: end; gap: 0.35rem; color: var(--muted); }
  .status-badge { padding: 0.3rem 0.7rem; border: 1px solid currentColor; border-radius: 999px; color: var(--fg); font-weight: 900; white-space: nowrap; }
  .node-reason { margin: 0; padding: 0 1.4rem 1rem 4.2rem; font-size: 1.05rem; }
  .node-links { margin: 0; padding: 0.85rem 1.4rem 0.95rem 4.2rem; border-top: 1px solid var(--line); list-style: none; color: var(--muted); font-size: 0.95rem; }
  .node-links li + li { margin-top: 0.3rem; }
  .flow-arrow { display: grid; place-items: center; min-height: 3.2rem; color: var(--accent); font-size: 1.8rem; font-weight: 900; }

  .node-detail {
    position: sticky;
    top: calc(var(--header-height) + 1rem);
    padding: 1.25rem;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .detail-kicker { margin: 0; color: var(--muted); font-size: 0.85rem; font-weight: 800; }
  .node-detail h2 { margin: 0.25rem 0 0.5rem; font-size: 1.45rem; }
  .node-detail > p:not(.detail-kicker) { margin: 0; font-size: 1.02rem; }
  .node-detail dl { margin: 1rem 0; }
  .node-detail dl div { padding: 0.7rem 0; border-top: 1px solid var(--line); }
  .node-detail dt { color: var(--muted); font-size: 0.82rem; }
  .node-detail dd { margin: 0.2rem 0 0; font-weight: 700; }
  .node-detail h3 { margin: 1rem 0 0.35rem; font-size: 1rem; }
  .node-detail ul { margin: 0; padding-left: 1.15rem; font-size: 0.9rem; overflow-wrap: anywhere; }
  .privacy-note { margin: 2rem 0 0; padding: 1rem; border-top: 1px solid var(--line); color: var(--muted); text-align: center; }

  @media (max-width: 820px) {
    .live-status { align-items: flex-start; flex-direction: column; }
    .map-layout { grid-template-columns: 1fr; }
    .node-detail { position: static; }
  }
  @media (max-width: 560px) {
    .node-toggle { flex-direction: column; }
    .node-state { justify-items: start; }
    .node-reason, .node-links { padding-left: 1.4rem; }
    .live-status dl { width: 100%; justify-content: space-between; }
  }
</style>
