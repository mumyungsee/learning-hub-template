---
import Base from '../../layouts/Base.astro';
import { WORKSPACE_MAP_SCHEMA_VERSION, createBaselineSnapshot, mapManifest, statusMeta } from '../../../scripts/workspace-map/manifest.mjs';

const baselineSnapshot = createBaselineSnapshot('learning-hub-template');
const orderedNodes = [...mapManifest.nodes].sort((a, b) => a.order - b.order);
const staticNodes = [...mapManifest.nodes, ...mapManifest.optionalExtensions.map((item) => ({ ...item, kind: 'optional' }))];
const nodeById = new Map(staticNodes.map((node) => [node.id, node]));

function anchor(nodeId, side = 'right') {
  const node = nodeById.get(nodeId);
  if (!node) return [0, 0];
  const { x, y, width, height } = node.layout;
  if (side === 'top') return [x + width / 2, y];
  if (side === 'bottom') return [x + width / 2, y + height];
  if (side === 'left') return [x, y + height / 2];
  return [x + width, y + height / 2];
}

function edgePoints(edge) {
  const start = anchor(edge.from, edge.fromSide ?? 'right');
  const end = anchor(edge.to, edge.toSide ?? 'left');
  if (edge.via) return [start, ...edge.via, end].map(([x, y]) => `${x},${y}`).join(' ');
  if (['top', 'bottom'].includes(edge.fromSide) || ['top', 'bottom'].includes(edge.toSide)) {
    const middle = (start[1] + end[1]) / 2;
    return `${start[0]},${start[1]} ${start[0]},${middle} ${end[0]},${middle} ${end[0]},${end[1]}`;
  }
  const middle = (start[0] + end[0]) / 2;
  return `${start[0]},${start[1]} ${middle},${start[1]} ${middle},${end[1]} ${end[0]},${end[1]}`;
}

const optionalBranchEdges = mapManifest.optionalExtensions
  .filter((item) => item.type !== 'pkm')
  .map((item) => ({ id: `optional-${item.type}-branch`, from: item.attachTo, to: item.id, fromSide: 'top', toSide: 'bottom', type: item.type }));
const pageData = JSON.stringify({ schemaVersion: WORKSPACE_MAP_SCHEMA_VERSION, manifest: mapManifest, snapshot: baselineSnapshot, statusMeta }).replaceAll('<', '\\u003c');
---

<Base title="나의 업무 위임 시스템" full>
  <main class="map-page">
    <header class="map-header">
      <div><p class="eyebrow">AX 실습 구조 지도</p><h1>{mapManifest.title}</h1><p>{mapManifest.description}</p></div>
      <section class="live-status" data-live-state="connecting" aria-live="polite">
        <div><strong id="status-message">로컬 상태를 연결하고 있어요.</strong><span id="workspace-label">기본 구조</span></div>
        <dl><div><dt>마지막 확인</dt><dd id="last-confirmed">아직 없음</dd></div><div><dt>확인 시간</dt><dd id="scan-duration">—</dd></div></dl>
      </section>
    </header>

    <section class="instruction-note" aria-label="구조 표시 원칙">
      <strong>고정 흐름은 한 번만 표시</strong><span>도구별 입구 → 공통 지침·맥락 → 명세</span><span>새 실행 능력만 별도 네모로 추가</span><span>HANDOFF는 재진입, PKM은 다음 업무 재사용</span>
    </section>
    <section class="legend" aria-label="지도 판독 기준">
      <span><i class="legend-swatch template-swatch"></i>기존 템플릿 흐름</span><span><i class="legend-swatch work-swatch"></i>이번 업무에서 새로 추가</span><span><i class="legend-swatch optional-swatch"></i>필요할 때만</span>
      <span><i class="legend-line branch-line"></i>기존 흐름에 붙는 확장</span><span><i class="legend-line knowledge-line"></i>PKM 저장·재사용 순환</span>
    </section>

    <section class="map-viewport" aria-label="업무 위임 구조 전체 지도">
      <div class="architecture-canvas" data-map-canvas style={`--canvas-width:${mapManifest.canvas.width}px;--canvas-height:${mapManifest.canvas.height}px`}>
        {mapManifest.boundaries.map((boundary) => <div class="template-core" data-boundary-id={boundary.id}><span>{boundary.label}</span></div>)}
        <svg class="map-connections" viewBox={`0 0 ${mapManifest.canvas.width} ${mapManifest.canvas.height}`} aria-hidden="true">
          <defs>
            <marker id="map-arrow" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L0,6 L8,3 z"></path></marker>
            <marker id="pkm-arrow" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L0,6 L8,3 z"></path></marker>
          </defs>
          {mapManifest.edges.map((edge) => <g class="map-edge" data-edge-id={edge.id} data-edge-style={edge.style}><polyline points={edgePoints(edge)} marker-end="url(#map-arrow)"></polyline></g>)}
          {optionalBranchEdges.map((edge) => <g class="optional-edge" data-optional-edge-type={edge.type}><polyline points={edgePoints(edge)}></polyline></g>)}
          {mapManifest.knowledgeEdges.map((edge) => (
            <g class="knowledge-edge-group" data-optional-edge-type="pkm" data-edge-id={edge.id}>
              <polyline points={edgePoints(edge)} marker-end="url(#pkm-arrow)"></polyline>
              <text x={edge.labelAt[0]} y={edge.labelAt[1]}>{edge.label}</text>
            </g>
          ))}
          <g data-live-extension-edges></g>
        </svg>

        {orderedNodes.map((node) => {
          const state = baselineSnapshot.nodes.find((item) => item.id === node.id);
          return (
            <button type="button" class="map-node template-node" data-node-id={node.id} data-status={state?.status ?? 'expected'} style={`--node-x:${node.layout.x}px;--node-y:${node.layout.y}px;--node-width:${node.layout.width}px;--node-height:${node.layout.height}px`}>
              <span class="node-topline"><span>템플릿 고정 자리</span><em data-node-status>{statusMeta[state?.status ?? 'expected'].symbol} {statusMeta[state?.status ?? 'expected'].label}</em></span>
              <strong>{node.label}</strong><span class="node-role">{node.role}</span>
            </button>
          );
        })}
        {mapManifest.optionalExtensions.map((node) => (
          <button type="button" class="map-node optional-node" data-optional-node data-optional-type={node.type} data-component-id={node.id} style={`--node-x:${node.layout.x}px;--node-y:${node.layout.y}px;--node-width:${node.layout.width}px;--node-height:${node.layout.height}px`}>
            <span class="node-topline"><span>선택 확장</span><em>{node.status}</em></span><strong>{node.label}</strong><span class="node-role">{node.role}</span>
            <span class="node-tooltip" role="tooltip"><b>연결한다면 쓸 위치</b>{node.paths.map((path) => <span>{path}</span>)}</span>
          </button>
        ))}
        <div data-live-extension-nodes></div>
      </div>
    </section>

    <aside class="node-detail" data-detail-panel aria-live="polite">
      <div><p class="detail-kicker">선택한 구성요소</p><h2 data-detail-title>네모를 눌러 자세히 봐</h2><p data-detail-role>구조는 지도에, 연결된 상대경로는 여기에 보여줘요.</p></div>
      <dl><div><dt>구분</dt><dd data-detail-type>—</dd></div><div><dt>상태</dt><dd data-detail-status>—</dd></div><div><dt>붙은 자리</dt><dd data-detail-attachment>—</dd></div></dl>
      <div class="detail-paths"><h3>이번 업무에서 연결한 파일</h3><ul data-detail-work><li>아직 선택하지 않았어요.</li></ul><h3>찾지 못한 파일</h3><ul data-detail-missing><li>없어요.</li></ul></div>
      <div class="detail-paths"><h3>템플릿에 이미 있는 파일</h3><ul data-detail-foundation><li>아직 선택하지 않았어요.</li></ul><h3>판정 이유</h3><p data-detail-reason>—</p></div>
    </aside>
    <p class="privacy-note">이 지도는 이 템플릿 안의 정해진 상대경로만 읽어요. 파일 내용·컴퓨터 전체 경로·환경정보를 외부로 보내지 않아요.</p>
  </main>
  <script id="workspace-map-data" type="application/json" set:html={pageData}></script>
</Base>

<script>
  const POLL_INTERVAL_MS = 2_000;
  const CHANGE_HIGHLIGHT_MS = 10_000;
  const ENDPOINT = '/__workspace-map/state.json';
  const SNAPSHOT_STORAGE_KEY = 'workspace-map:last-live-snapshot';
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const source = document.querySelector('#workspace-map-data');
  const pageData = JSON.parse(source?.textContent ?? '{}');
  const manifest = pageData.manifest;
  const statusMeta = pageData.statusMeta;
  let currentSnapshot = pageData.snapshot;
  try {
    const stored = JSON.parse(sessionStorage.getItem(SNAPSHOT_STORAGE_KEY) ?? 'null');
    if (stored?.schemaVersion === 3 && stored?.mode === 'live' && Array.isArray(stored.nodes) && Array.isArray(stored.extensions)) currentSnapshot = stored;
  } catch { sessionStorage.removeItem(SNAPSHOT_STORAGE_KEY); }
  let selected = { kind: 'fixed', id: 'owner' };
  let lastSuccessful = null;
  let inFlight = false;
  let renderedExtensionsFingerprint = null;
  const recentFixedIds = new Set();
  const recentExtensionIds = new Set();
  const changeTimers = new Map();
  const definitions = new Map(manifest.nodes.map((item) => [item.id, item]));
  const extensionDefinitions = new Map(manifest.extensionTypes.map((item) => [item.type, item]));
  const optionalDefinitions = new Map(manifest.optionalExtensions.map((item) => [item.id, item]));
  const cards = new Map([...document.querySelectorAll('[data-node-id]')].map((item) => [item.dataset.nodeId, item]));
  const statusBox = document.querySelector('.live-status');

  function renderList(target, values, emptyText) {
    if (!target) return;
    const safeValues = values.length ? values : [emptyText];
    target.replaceChildren(...safeValues.map((value) => { const item = document.createElement('li'); item.textContent = value; return item; }));
  }

  function statusLabel(status) {
    const meta = statusMeta[status];
    return meta ? `${meta.symbol} ${meta.label}` : status;
  }

  function fixedDetail(id) {
    const definition = definitions.get(id);
    const state = currentSnapshot.nodes.find((item) => item.id === id);
    if (!definition || !state) return null;
    return { label: definition.label, role: definition.role, type: '템플릿의 고정 자리', status: statusLabel(state.status), attachTo: '기본 위임 흐름', work: [...state.workPaths, ...state.evidencePaths], missing: state.missingWorkPaths, foundation: state.foundationPaths, reason: state.reason };
  }

  function extensionDetail(id) {
    const state = currentSnapshot.extensions.find((item) => item.id === id);
    if (!state) return null;
    return { label: state.label, role: state.role, type: extensionDefinitions.get(state.type)?.label ?? state.type, status: statusLabel(state.status), attachTo: definitions.get(state.attachTo)?.label ?? state.attachTo, work: state.paths, missing: state.missingPaths, foundation: [], reason: state.reason };
  }

  function optionalDetail(id) {
    const item = optionalDefinitions.get(id);
    if (!item) return null;
    return { label: item.label, role: item.role, type: '선택 확장', status: item.status, attachTo: definitions.get(item.attachTo)?.label ?? item.attachTo, work: item.paths, missing: [], foundation: [], reason: '실제 연결 파일이 생기기 전에는 진행 상태로 세지 않아요.' };
  }

  function renderDetail(kind, id) {
    const detail = kind === 'extension' ? extensionDetail(id) : kind === 'optional' ? optionalDetail(id) : fixedDetail(id);
    if (!detail) return;
    selected = { kind, id };
    const panel = document.querySelector('[data-detail-panel]');
    panel.querySelector('[data-detail-title]').textContent = detail.label;
    panel.querySelector('[data-detail-role]').textContent = detail.role;
    panel.querySelector('[data-detail-type]').textContent = detail.type;
    panel.querySelector('[data-detail-status]').textContent = detail.status;
    panel.querySelector('[data-detail-attachment]').textContent = detail.attachTo;
    panel.querySelector('[data-detail-reason]').textContent = detail.reason;
    renderList(panel.querySelector('[data-detail-work]'), detail.work, '이번 업무에서 연결한 파일이 없어요.');
    renderList(panel.querySelector('[data-detail-missing]'), detail.missing, '없어요.');
    renderList(panel.querySelector('[data-detail-foundation]'), detail.foundation, '기본 제공 파일이 없어요.');
    document.querySelectorAll('[data-node-id],[data-component-id],[data-extension-id]').forEach((node) => {
      const nodeId = node.dataset.nodeId ?? node.dataset.componentId ?? node.dataset.extensionId;
      node.toggleAttribute('data-selected', nodeId === id);
    });
  }

  function anchor(layout, side = 'right') {
    if (side === 'top') return [layout.x + layout.width / 2, layout.y];
    if (side === 'bottom') return [layout.x + layout.width / 2, layout.y + layout.height];
    if (side === 'left') return [layout.x, layout.y + layout.height / 2];
    return [layout.x + layout.width, layout.y + layout.height / 2];
  }

  function pointsBetween(fromLayout, toLayout, fromSide, toSide, via = []) {
    const start = anchor(fromLayout, fromSide);
    const end = anchor(toLayout, toSide);
    if (via.length) return [start, ...via, end].map((point) => point.join(',')).join(' ');
    const middle = (start[1] + end[1]) / 2;
    return `${start[0]},${start[1]} ${start[0]},${middle} ${end[0]},${middle} ${end[0]},${end[1]}`;
  }

  function extensionLayout(extension, occurrences) {
    const base = extensionDefinitions.get(extension.type).layout;
    const index = occurrences.get(extension.type) ?? 0;
    occurrences.set(extension.type, index + 1);
    return { ...base, x: base.x + index * 18, y: base.y + index * 18 };
  }

  function appendEdge(group, points, kind = 'branch', marker = false) {
    const line = document.createElementNS(SVG_NS, 'polyline');
    line.setAttribute('points', points);
    line.setAttribute('class', kind === 'knowledge' ? 'live-knowledge-edge' : 'live-branch-edge');
    if (marker) line.setAttribute('marker-end', 'url(#pkm-arrow)');
    group.append(line);
  }

  function createExtensionCard(extension, layout) {
    const definition = extensionDefinitions.get(extension.type);
    const card = document.createElement('button');
    card.type = 'button';
    card.className = 'map-node work-node';
    card.dataset.extensionId = extension.id;
    card.dataset.status = extension.status;
    card.classList.toggle('is-changed', recentExtensionIds.has(extension.id));
    card.style.setProperty('--node-x', `${layout.x}px`);
    card.style.setProperty('--node-y', `${layout.y}px`);
    card.style.setProperty('--node-width', `${layout.width}px`);
    card.style.setProperty('--node-height', `${layout.height}px`);
    const top = document.createElement('span'); top.className = 'node-topline';
    const type = document.createElement('span'); type.textContent = definition.label;
    const status = document.createElement('em'); status.textContent = statusLabel(extension.status);
    top.append(type, status);
    const title = document.createElement('strong'); title.textContent = extension.label;
    const role = document.createElement('span'); role.className = 'node-role'; role.textContent = extension.role;
    const tooltip = document.createElement('span'); tooltip.className = 'node-tooltip'; tooltip.role = 'tooltip';
    const tooltipTitle = document.createElement('b'); tooltipTitle.textContent = '이번 업무에서 연결한 파일'; tooltip.append(tooltipTitle);
    [...extension.paths, ...extension.missingPaths].forEach((path) => { const item = document.createElement('span'); item.textContent = path; tooltip.append(item); });
    card.append(top, title, role, tooltip);
    card.addEventListener('click', () => renderDetail('extension', extension.id));
    return card;
  }

  function renderExtensions() {
    const fingerprint = JSON.stringify(currentSnapshot.extensions.map((item) => [item.id, item.label, item.type, item.status, item.paths, item.missingPaths]));
    if (fingerprint === renderedExtensionsFingerprint) return;
    renderedExtensionsFingerprint = fingerprint;
    const nodeLayer = document.querySelector('[data-live-extension-nodes]');
    const edgeLayer = document.querySelector('[data-live-extension-edges]');
    nodeLayer.replaceChildren();
    edgeLayer.replaceChildren();
    const actualTypes = new Set(currentSnapshot.extensions.map((item) => item.type));
    document.querySelectorAll('[data-optional-type]').forEach((item) => { item.hidden = actualTypes.has(item.dataset.optionalType); });
    document.querySelectorAll('[data-optional-edge-type]').forEach((item) => { item.hidden = actualTypes.has(item.dataset.optionalEdgeType); });
    const occurrences = new Map();
    for (const extension of currentSnapshot.extensions) {
      const definition = extensionDefinitions.get(extension.type);
      if (!definition) continue;
      const layout = extensionLayout(extension, occurrences);
      nodeLayer.append(createExtensionCard(extension, layout));
      if (extension.type === 'pkm') {
        const outputLayout = definitions.get('output').layout;
        const contextLayout = definitions.get('context').layout;
        appendEdge(edgeLayer, pointsBetween(outputLayout, layout, 'bottom', 'top'), 'knowledge', true);
        appendEdge(edgeLayer, pointsBetween(layout, contextLayout, 'right', 'top', [[1450, layout.y + layout.height / 2], [1450, 105], [520, 105]]), 'knowledge', true);
      } else {
        const parent = definitions.get(extension.attachTo).layout;
        const above = layout.y + layout.height <= parent.y;
        appendEdge(edgeLayer, pointsBetween(parent, layout, above ? 'top' : 'bottom', above ? 'bottom' : 'top'));
      }
    }
  }

  function rememberChange(kind, id) {
    const key = `${kind}:${id}`;
    const target = kind === 'extension' ? recentExtensionIds : recentFixedIds;
    target.add(id);
    window.clearTimeout(changeTimers.get(key));
    changeTimers.set(key, window.setTimeout(() => {
      target.delete(id);
      changeTimers.delete(key);
      if (kind === 'fixed') cards.get(id)?.classList.remove('is-changed');
      else document.querySelector(`[data-extension-id="${id}"]`)?.classList.remove('is-changed');
    }, CHANGE_HIGHLIGHT_MS));
  }

  function rememberSnapshotChanges(before, after) {
    if (!before || before.mode !== 'live') return;
    const oldNodes = new Map(before.nodes.map((item) => [item.id, JSON.stringify([item.status, item.workPaths, item.missingWorkPaths, item.evidencePaths, item.latestModifiedAt])]));
    for (const item of after.nodes) {
      const next = JSON.stringify([item.status, item.workPaths, item.missingWorkPaths, item.evidencePaths, item.latestModifiedAt]);
      if (oldNodes.get(item.id) !== next) rememberChange('fixed', item.id);
    }
    const oldExtensions = new Set(before.extensions.map((item) => item.id));
    for (const item of after.extensions) if (!oldExtensions.has(item.id)) rememberChange('extension', item.id);
  }

  function renderSnapshot(snapshot) {
    const before = currentSnapshot;
    rememberSnapshotChanges(before, snapshot);
    currentSnapshot = snapshot;
    for (const state of snapshot.nodes) {
      const card = cards.get(state.id);
      if (!card) continue;
      card.dataset.status = state.status;
      card.classList.toggle('is-changed', recentFixedIds.has(state.id));
      card.querySelector('[data-node-status]').textContent = statusLabel(state.status);
    }
    renderExtensions();
    const selectedStillExists = selected.kind !== 'extension' || snapshot.extensions.some((item) => item.id === selected.id);
    if (selectedStillExists) renderDetail(selected.kind, selected.id);
    else renderDetail('fixed', 'owner');
  }

  function showConnected(snapshot) {
    statusBox.dataset.liveState = 'live';
    const message = document.querySelector('#status-message');
    const label = document.querySelector('#workspace-label');
    if (snapshot.activeWork?.status === 'connected') {
      message.textContent = `이번 업무 “${snapshot.activeWork.title}”와 연결됐어요. 실행 확장 ${snapshot.extensionSummary.total}개를 표시해요.`;
      label.textContent = `${snapshot.rootLabel} · ${snapshot.activeWork.pointerPath}`;
    } else if (snapshot.activeWork?.status === 'invalid') {
      statusBox.dataset.liveState = 'stale'; message.textContent = snapshot.activeWork.reason; label.textContent = snapshot.activeWork.pointerPath;
    } else {
      message.textContent = '기본 환경은 준비됐어요. 이번에 위임할 업무는 아직 연결되지 않았어요.'; label.textContent = snapshot.rootLabel;
    }
    document.querySelector('#last-confirmed').textContent = new Date(snapshot.generatedAt).toLocaleTimeString('ko-KR');
    document.querySelector('#scan-duration').textContent = `${snapshot.durationMs}ms`;
  }

  function showStale() {
    statusBox.dataset.liveState = 'stale';
    document.querySelector('#status-message').textContent = '업데이트가 멈췄어요. 로컬 미리보기가 켜져 있는지 확인해 주세요.';
    if (lastSuccessful) document.querySelector('#last-confirmed').textContent = `${new Date(lastSuccessful).toLocaleTimeString('ko-KR')} 마지막 정상 확인`;
  }

  async function refresh() {
    if (inFlight || document.hidden) return;
    inFlight = true;
    try {
      const response = await fetch(ENDPOINT, { cache: 'no-store' });
      if (!response.ok) throw new Error('workspace-map-unavailable');
      const snapshot = await response.json();
      if (snapshot.schemaVersion !== pageData.schemaVersion || snapshot.mode !== 'live' || !Array.isArray(snapshot.nodes) || !Array.isArray(snapshot.extensions)) throw new Error('workspace-map-invalid');
      renderSnapshot(snapshot);
      lastSuccessful = snapshot.generatedAt;
      try { sessionStorage.setItem(SNAPSHOT_STORAGE_KEY, JSON.stringify(snapshot)); } catch { sessionStorage.removeItem(SNAPSHOT_STORAGE_KEY); }
      showConnected(snapshot);
    } catch { showStale(); }
    finally { inFlight = false; }
  }

  for (const [id, card] of cards) card.addEventListener('click', () => renderDetail('fixed', id));
  document.querySelectorAll('[data-optional-node]').forEach((card) => card.addEventListener('click', () => renderDetail('optional', card.dataset.componentId)));
  document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
  renderSnapshot(currentSnapshot);
  const first = currentSnapshot.extensions[0];
  renderDetail(first ? 'extension' : 'fixed', first?.id ?? 'owner');
  refresh();
  window.setInterval(refresh, POLL_INTERVAL_MS);
</script>

<style>
