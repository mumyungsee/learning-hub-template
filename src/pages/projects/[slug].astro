---
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import { getProjects, getCasesOf, getWikiSetsOfProject } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const cases = await getCasesOf(entry.slug);
const wikis = await getWikiSetsOfProject(entry.slug);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const 완성 = entry.data.status === '완성';
---

<Base title={entry.data.title} description={entry.data.summary}>
  <a href="/projects" class="back-link">← 프로젝트 목록</a>

  <header class="head">
    <span class:list={['badge', entry.data.status]}>{entry.data.status}</span>
    <h1 class="page-title">{entry.data.title}</h1>
    {entry.data.summary && <p class="lead">{entry.data.summary}</p>}
    <div class="meta">
      시작 {fmt(entry.data.date)}
      {entry.data.tags && entry.data.tags.length > 0 && (
        <span> · {entry.data.tags.map((t) => `#${t}`).join(' ')}</span>
      )}
    </div>
    {entry.data.링크 && (
      <a class="cta" href={entry.data.링크} target="_blank" rel="noopener noreferrer">
        {완성 ? '완성작 보러가기 →' : '체험해보기 →'}
      </a>
    )}
  </header>

  <Prose>
    <Content />
  </Prose>

  <section class="wikis">
    <h2>이 프로젝트의 위키 · 전자책</h2>
    {wikis.length === 0 ? (
      <p class="shelf-hint">아직 이 프로젝트의 위키가 없어요.</p>
    ) : (
      <ul>
        {wikis.map((w) => (
          <li>
            <a href={`/wikis/${w.slug}`}>
              <strong>{w.title}</strong>
              {w.summary && <span class="sub"> — {w.summary}</span>}
            </a>
            <a class="book" href={`/ebook/${w.slug}`}>책으로 보기 →</a>
          </li>
        ))}
      </ul>
    )}
    <p class="shelf-hint">
      프로젝트 카드를 만들면 위키와 전자책이 같이 생겨요.
      글 맨 위에 <code>프로젝트: {entry.slug}</code>를 적으면 이 위키에 모여요.
      제목을 바꾸거나, 프로젝트와 상관없는 위키를 더 만들 때만
      <code>src/content/wikis/</code>에 파일을 추가하면 돼요.
    </p>
  </section>

  <!-- 이 프로젝트에 엮인 사례글 연재 -->
  {cases.length > 0 && (
    <section class="series">
      <h2>작업 기록</h2>
      <ol>
        {cases.map((c, i) => (
          <li>
            <a href={`/wiki/${c.slug}`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="body">
                <strong>{c.data.title}</strong>
                {c.data.summary && <span class="summary">{c.data.summary}</span>}
                <span class="date">{fmt(c.data.date)}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}
</Base>

<style>
  .shelf-hint {
    margin: -1rem 0 2rem; padding: 0.7rem 0.9rem;
    border-left: 2px solid var(--line);
    font-size: 0.85rem; color: var(--muted); line-height: 1.6;
  }
  .shelf-hint code {
    background: var(--surface); padding: 0.1rem 0.3rem; border-radius: 4px;
  }

  .book-link {
    display: flex; align-items: center; gap: 0.9rem;
    margin: 2rem 0; padding: 1rem 1.15rem;
    border: 1px solid var(--line); border-radius: var(--radius);
    text-decoration: none; color: inherit; background: var(--surface);
    transition: border-color 0.15s, transform 0.15s;
  }
  .book-link:hover { border-color: var(--muted); transform: translateY(-1px); }
  .book-link .icon { font-size: 1.4rem; line-height: 1; }
  .book-link .txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .book-link .sub { font-size: 0.83rem; color: var(--muted); }
  .book-link .arrow { color: var(--muted); }

  .head { margin-bottom: 2rem; }
  .head .page-title { margin: 0.6rem 0 0.4rem; }
  .head .lead { color: var(--muted); font-size: 1.05rem; margin: 0 0 0.6rem; }
  .head .meta { font-size: 0.82rem; color: var(--muted); }
  .cta {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }
  .cta:hover { opacity: 0.85; }

  .series { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .series h2 { font-size: 1.25rem; margin: 0 0 1rem; }
  .series ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .series a { display: flex; gap: 1rem; padding: 0.9rem 1rem; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; }
  .series a:hover { border-color: var(--muted); }
  .series .num { font-size: 1.4rem; font-weight: 700; color: var(--line); }
  .series .body { display: flex; flex-direction: column; }
  .series .summary { color: var(--muted); font-size: 0.9rem; }
  .series .date { font-size: 0.78rem; color: var(--muted); margin-top: 0.2rem; }

  .wikis { margin: 2rem 0; }
  .wikis h2 { font-size: 1.25rem; margin: 0 0 0.8rem; }
  .wikis ul { list-style: none; margin: 0; padding: 0; }
  .wikis li {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding: 0.7rem 0; border-bottom: 1px solid var(--line);
  }
  .wikis a { text-decoration: none; color: inherit; }
  .wikis .sub { color: var(--muted); font-size: 0.88rem; }
  .wikis .book { font-size: 0.85rem; white-space: nowrap; color: var(--fg); }
  /* 위키 목록 밑 안내는 위로 끌어올리지 않는다 (목록 줄과 겹쳐 보였음) */
  .wikis .shelf-hint { margin: 0.8rem 0 0; }
</style>
