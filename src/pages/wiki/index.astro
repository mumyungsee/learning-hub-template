---
import WikiLayout from '../../layouts/WikiLayout.astro';
import { getWikiSets, getWikiGrouped, DEFAULT_WIKI_SLUG } from '../../lib/content';

const sets = await getWikiSets();
const 여러개 = sets.length > 1;
const { roadmap, weeks } = await getWikiGrouped(여러개 ? undefined : (sets[0]?.slug ?? DEFAULT_WIKI_SLUG));
const totalAll = 여러개
  ? null
  : weeks.reduce((n, w) => n + w.items.length, 0) + roadmap.length;
const 첫글 = roadmap[0] ?? weeks[0]?.items[0];
---

<WikiLayout title="학습위키" description="주제별로 나눈 위키와, 주차별로 쌓인 글">
  <div class="intro">
    <h1 class="page-title">학습위키</h1>
    <p class="page-desc">
      {여러개
        ? '위키를 여러 개 둘 수 있어요. 하나를 고르면 그 글이 열려요. 위키마다 전자책도 한 권씩 만들 수 있어요.'
        : <>배운 것이 주차별로 여기 쌓여요. 지금까지 <strong>{totalAll}개</strong> 글이 모였어요. 왼쪽 목록에서 글을 고르면 이 자리에 본문이 열려요.</>
      }
    </p>
    <p class="how">
      위키를 하나 더 만들려면 <code>src/content/wikis/</code> 안에 파일 하나만 만들면 돼요.
      글에는 <code>위키: (파일 이름)</code> 한 줄만 넣으면 됩니다.
    </p>

    {여러개 && (
      <div class="wiki-grid">
        {sets.map((s) => (
          <a class="wiki-card" href={s.slug === DEFAULT_WIKI_SLUG && s.implicit ? '/wiki' : `/wikis/${s.slug}`}>
            <strong>{s.title}</strong>
            {s.summary && <span class="sum">{s.summary}</span>}
            {s.책 && <span class="book">서재에 꽂힌 책</span>}
          </a>
        ))}
      </div>
    )}

    {!여러개 && (
      <>
        {totalAll === 0 ? (
          <div class="empty">
            아직 비어 있어요. <br />
            처음에는 글이 거의 없어도 정상이에요. 글을 하나 만들면 여기와 왼쪽 목록에 나타나요.
          </div>
        ) : (
          <>
            {첫글 && (
              <a href={`/wiki/${첫글.slug}`} class="start-btn">
                {roadmap[0] ? '로드맵부터 보기 →' : '첫 글부터 보기 →'}
              </a>
            )}
            <div class="weeks-preview">
              {weeks.map(({ 주차, items }) => (
                <div class="wk-card">
                  <div class="wk-num">{주차 > 0 ? `${주차}주차` : '기타'}</div>
                  <div class="wk-count">{items.length}개 글</div>
                </div>
              ))}
            </div>
          </>
        )}
      </>
    )}
  </div>
</WikiLayout>

<style>
  .how {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.7;
    margin: 0 0 1.5rem;
  }
  .how code {
    background: var(--surface);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
  }
  .wiki-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
    margin: 1rem 0 2rem;
  }
  .wiki-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
    text-decoration: none;
    color: inherit;
  }
  .wiki-card:hover { border-color: var(--muted); }
  .wiki-card .sum { font-size: 0.85rem; color: var(--muted); }
  .wiki-card .book { font-size: 0.75rem; color: var(--green-fg); }
  .start-btn {
    display: inline-block;
    margin: 0.5rem 0 2rem;
    padding: 0.55rem 1.2rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .start-btn:hover { opacity: 0.85; }
  .weeks-preview { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .wk-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.9rem 1.2rem;
    min-width: 100px;
  }
  .wk-num { font-weight: 700; }
  .wk-count { font-size: 0.82rem; color: var(--muted); }
  .empty {
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    padding: 1.5rem 1rem;
    color: var(--muted);
  }
</style>
